# Copy to .env and adjust. Never commit the real .env.
# dev | prod (prod => Secure cookies)
ENVIRONMENT=dev
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://algo:algo@localhost:5432/algo
TEST_DATABASE_URL=postgresql+psycopg://algo:algo@localhost:5432/algo_test
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# docker-compose
POSTGRES_USER=algo
POSTGRES_PASSWORD=algo
POSTGRES_DB=algo
